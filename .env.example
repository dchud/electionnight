# Copy to .env. Every setting below shows its default; keep only what you
# change. Nested groups use a double underscore. List and dict values are JSON.

# Secrets
ANTHROPIC_API_KEY=
FEC_API_KEY=

# Paths, relative to the repository root
PATHS__CATALOG=data/catalog.sqlite
PATHS__DATA=data/lake/
PATHS__MODELS=data/models/
PATHS__UI_DB=data/ui.sqlite
PATHS__BACKUPS=data/backups/
PATHS__REF=data/ref/
PATHS__CONTROL=data/control/
PATHS__LAST_COMMIT=data/last_commit.json
PATHS__STATUS=data/status.json
PATHS__ARCHIVE=data/archive/
PATHS__WRITER_LOCK=data/writer.lock
PATHS__LOGS=logs/
PATHS__REPORTS=reports/
PATHS__CONFIG=config/

# Feed polling
POLL__TIER_SECONDS=[60,180,600]
POLL__PER_DOMAIN_CONCURRENCY=2
POLL__JITTER_PCT=15
POLL__TIMEOUT_SECONDS=20.0
POLL__USER_AGENT=ElectionNightMonitor/1.0 (personal research)
POLL__CIRCUIT_FAILURES=5
POLL__CIRCUIT_RETRY_SECONDS=900
POLL__PROBE_URLS=["https://www.gstatic.com/generate_204","https://api.anthropic.com/","https://www.cloudflare.com/cdn-cgi/trace"]
POLL__PROBE_TIMEOUT_SECONDS=8.0
POLL__PROBE_SECONDS=10.0
POLL__PROBE_CACHE_SECONDS=5.0
POLL__SLEEP_GAP_SECONDS=60.0
POLL__RESUME_STAGGER_SECONDS=30.0
POLL__MIN_GAP_SECONDS=60.0

# Lake commits and maintenance
COMMIT__BATCH_SECONDS=30
COMMIT__MAINTENANCE_MINUTES=15
COMMIT__BACKUP_MINUTES=15
COMMIT__BACKUPS_KEEP_RECENT=12

# DuckLake options, applied by `monitor init`
LAKE__PARQUET_COMPRESSION=zstd
LAKE__PARQUET_COMPRESSION_LEVEL=6
LAKE__TARGET_FILE_SIZE=128MB
LAKE__DATA_INLINING_ROW_LIMIT=2000

# Parsers
NLP__RELEVANCE_THRESHOLD=0.5
NLP__EMBED_MODEL=intfloat/multilingual-e5-small
NLP__EMBED_BATCH_SIZE=32
NLP__EMBED_DUTY_CYCLE=0.4
NLP__STORYLINE_JOIN=0.92
NLP__STORYLINE_MERGE=0.95
NLP__STORYLINE_PROMOTE_ITEMS=3
NLP__STORYLINE_PROMOTE_SOURCES=2
NLP__DEDUPE_COSINE=0.95
NLP__DEDUPE_SIMHASH_DISTANCE=3
NLP__DEDUPE_WINDOW_HOURS=36
NLP__ENTITY_FUZZY_SCORE=92
NLP__FETCH_DOMAIN_INTERVAL_SECONDS=3.0
NLP__FETCH_TIMEOUT_SECONDS=10.0
NLP__TOUR_SECONDS=30

# Claude API
LLM__MODEL_BULK=claude-haiku-5-5
LLM__MODEL_BRIEF=claude-sonnet-5-5
LLM__CONCURRENCY_A=6
LLM__CONCURRENCY_B=8
LLM__CONCURRENCY_MISC=2
LLM__BATCH_A=10
LLM__DAILY_USD_CAP=40.0
LLM__HARD_USD_CAP=75.0
LLM__BRIEF_MINUTES=20
LLM__BRIEF_IDLE_MINUTES=60
LLM__BRIEF_LIVE_FROM=2026-11-03T16:00:00-05:00
LLM__DEGRADE_AFTER_SECONDS=120
LLM__PRICES_PER_MTOK={"claude-haiku-5-5":[0.10,0.50],"claude-sonnet-5-5":[2.0,10.0]}
LLM__CACHE_READ_MULTIPLIER=0.1
LLM__CACHE_WRITE_MULTIPLIER=1.25

# Web
WEB__HOST=127.0.0.1
WEB__PORT=8000
WEB__FRAGMENT_THROTTLE_SECONDS=10
WEB__SLOW_QUERY_MS=500
WEB__SLOW_THROTTLE_SECONDS=20
WEB__SNAPSHOT_POLL_SECONDS=3.0
WEB__QUERY_CACHE_SIZE=512
WEB__DEFAULT_WINDOW=1h
WEB__TIMEZONE=America/New_York

# Disk guard thresholds, in GB free
DISK__WARN_GB=10.0
DISK__DEGRADE_GB=5.0
DISK__AUTOPRUNE_GB=3.0

# Archive of original feed payloads and article pages, and S3 offload
ARCHIVE__ENABLED=true
ARCHIVE__COMPRESSION_LEVEL=9
ARCHIVE__WINDOW_LOG=26
ARCHIVE__FLUSH_SECONDS=30
ARCHIVE__MIN_FREE_GB=15.0
ARCHIVE__UPLOAD_MINUTES=60
ARCHIVE__LOCAL_KEEP_HOURS=24
ARCHIVE__S3_BUCKET=
ARCHIVE__S3_REGION=us-east-1
ARCHIVE__S3_PREFIX=electionnight
ARCHIVE__S3_ACCESS_KEY_ID=
ARCHIVE__S3_SECRET_ACCESS_KEY=
